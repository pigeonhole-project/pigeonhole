[DEFAULT]
host = 127.0.0.1
port = 8333
is_secure = False
ssl_verify = False

[fixtures]
bucket prefix = pigeonhole-{random}-
iam name prefix = pigeonhole-
iam path prefix = /pigeonhole/

[s3 main]
display_name = pigeonhole
user_id = pigeonhole
email = pigeonhole@example.com
api_name = default
access_key = __ACCESS_KEY__
secret_key = __SECRET_KEY__

[s3 alt]
# Same credentials: pigeonhole is single-tenant. ACL/alt-user tests will fail.
display_name = pigeonhole-alt
user_id = pigeonhole-alt
email = pigeonhole-alt@example.com
access_key = __ACCESS_KEY__
secret_key = __SECRET_KEY__

[s3 tenant]
display_name = pigeonhole-tenant
user_id = pigeonhole-tenant
email = pigeonhole-tenant@example.com
access_key = __ACCESS_KEY__
secret_key = __SECRET_KEY__
tenant = pigeonhole

[iam]
display_name = pigeonhole-iam
user_id = pigeonhole-iam
email = pigeonhole-iam@example.com
access_key = __ACCESS_KEY__
secret_key = __SECRET_KEY__

[iam root]
access_key = __ACCESS_KEY__
secret_key = __SECRET_KEY__
account_id = pigeonhole
user_id = pigeonhole
email = pigeonhole@example.com

[iam alt root]
access_key = __ACCESS_KEY__
secret_key = __SECRET_KEY__
account_id = pigeonhole-alt
user_id = pigeonhole-alt
email = pigeonhole-alt@example.com
