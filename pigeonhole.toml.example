# Copy to pigeonhole.toml and adjust. Secrets stay in .env (see .env.example).
#
#   cp pigeonhole.toml.example pigeonhole.toml
#   cp .env.example .env
#
# Override path with PIGEONHOLE_CONFIG=/path/to.toml

listen_addr = "0.0.0.0:8333"
region = "us-east-1"

# Sizes are bytes or strings with a binary unit ("1 MiB", "512 KiB"); decimal
# units (KB, MB, GB, k, m) are refused. Durations are strings ("45s", "10m",
# "7d", "1m 30s"). What can be switched off takes "off" (zero is refused there).

# Stores: where bytes live. kind = local_disk (path) | memory | telegram
# (chat_id) | discord (channel_id). Every kind holds blobs; the log and
# snapshots go to local_disk, memory (tests: no fsync, gone with the process),
# telegram or discord (each its own channel). Secrets come from env vars named in the store (defaults:
# BOT_TOKEN, TG_API_ID, TG_API_HASH / DISCORD_BOT_TOKEN), never inline. A store
# serves one purpose (the blob sweeper deletes our blobs it does not know; the
# log's fence reads its channel's message order); only a local_disk or memory
# store holds both the log and the snapshots.
[[store]]
id = "meta"
kind = "local_disk"
path = "pigeonhole-meta"

# Telegram over MTProto, logged in as a bot: a channel or supergroup (-100…)
# where the bot is an admin with post and delete rights. api_id / api_hash are
# an app's, from my.telegram.org. The session file caches the login (one per
# bot, shared by its stores; secret, 0600).
[[store]]
id = "tg-main"
kind = "telegram"
chat_id = -1001234567890
# bot_token_env = "BOT_TOKEN"
# api_id_env = "TG_API_ID"
# api_hash_env = "TG_API_HASH"
# session = "pigeonhole-tg-<bot id>.session"

# [[store]]
# id = "dc-backup"
# kind = "discord"
# channel_id = 123456789012345678
# max_blob_size = "20 MiB"   # optional, the default (more on boosted servers)

# Local runs / tests without any chat:
# [[store]]
# id = "mem"
# kind = "memory"

# Copies: every chunk goes to all members, write_quorum must succeed.
# [[replicas]]
# id = "blobs"
# members = ["tg-main", "dc-backup"]
# write_quorum = 1

# Parts: every chunk goes to one member (the least loaded), a store or a
# [[replicas]] group. Telegram limits are per chat, so shards add throughput;
# replicas inside a shard add availability.
# [[shards]]
# id = "spread"
# members = ["tg-main", "tg-second", "blobs"]

# Metadata tablet (docs/meta-backends.md): every metadata change is appended to
# the command log, then applied to in-memory state; every boot loads the
# snapshot the log starts from and replays the rest. A second process on the
# same log fences (stops) the first.
[meta]
log = "meta"                  # default: a local_disk at pigeonhole-meta
snapshot = "meta"             # default: the log's store if it is local_disk / memory
# A telegram log (a dedicated channel, fenced by the order of its
# messages) or a discord log (a dedicated text channel, fenced by threads)
# needs its snapshots in another channel; a memory log needs memory
# snapshots.
# A local_disk log with snapshots in a channel or on another disk survives
# losing the log's disk: `pigeonhole restore --lossy` starts a new log from
# the newest snapshot.
snapshot_every_entries = 10000     # snapshot all states, drop the log behind it; "off" = never
snapshot_every = "10m"             # and this often if anything changed; "off" = never
keep_snapshots = 2                 # newest snapshots kept, with the log between them (a boot
                                   # falls back to an older one if the newest is damaged)
# lease = "45s"                    # a discord log's lease (docs/discord-lease.md), or "off"

[chunk]
store = "tg-main"             # a blob store or a [[replicas]] group
# Max on-wire document size. With codec zstd/gzip, independent 1 MiB blocks are
# packed until this size (or 256 MiB logical) is reached.
size = "19 MiB"
# Encoding policy for new uploads: "raw" | "gzip" | "zstd" (default zstd).
# Compressing policies store chunks as codec "blocks" (see chunk_blocks table).
codec = "zstd"
# Logical block size for block packing (default 1 MiB).
block_size = "1 MiB"

# Small objects in the metadata (docs/inline-objects.md): stored in the log
# entry that writes them, read from memory, no chunk and no post. A cooler
# moves them out to chunks once cold or when the tablet holds too many.
[inline]
max_object_size = "1 KiB"     # "off" = never inline
budget = "64 MiB"             # all inline bytes; above it the oldest go out
low_watermark = 0.9           # ... until under this share of the budget
cool_after = "10m"            # out once not rewritten this long ("off" = only by budget)
min_inline = "30s"            # never out while written less than this long ago
cool_every = "1m"
cool_batch = 64

[ingest]
# Process-wide cap on ingest buffers across concurrent PUTs (default 256 MiB).
memory_budget = "256 MiB"

[telegram]
# Telegram budgets on two levels (docs/shared-limiter.md). Bot: every call of
# one token, across all its chats (Telegram: ~30/s). Class: per chat and per
# kind of call, each call also taking a bot token. A FLOOD_WAIT freezes the
# bucket it hit for its wait (a getFile or upload one: the whole bot), and
# the bucket starts empty after it.
upload_concurrency = 2
download_concurrency = 8
[telegram.bot]
rate_per_sec = 25.0
burst = 30.0
[telegram.send]
# ~20 messages a minute per bot in a channel, so 18.
rate_per_sec = 0.3
burst = 3.0
[telegram.read]
# getMessages (reads by id: the log's fence checks, listing for the sweeper).
rate_per_sec = 2.0
burst = 5.0
[telegram.delete]
rate_per_sec = 1.0
burst = 5.0

[discord]
# The same tables as [telegram] (bot, send, read, delete), for Discord
# channels; defaults: ~5 messages per 5 s per bot in a channel (send 1.0,
# burst 5), reads 5/s, the bot 40/s. A 429 cools its class in the channel;
# one marked global, the whole bot.
# [discord.send]
# rate_per_sec = 1.0
# burst = 5.0

[cache]
# In-memory block caches: a read looks in L1 (decoded blocks), then L2
# (stored, compressed blocks), then the backend. Raw chunks are not cached.
enabled = true
l1_size = "128 MiB"
l2_size = "256 MiB"           # "off" = no L2
# Chunks written put their stored blocks into L2 (read-after-write is free).
write_through = true

# Bazel/Buck2 remote cache (REAPI v2 + ByteStream). Requires building pigeonhole with
# `--features bytestream`. Disabled by default.
[bytestream]
enabled = false
listen_addr = "127.0.0.1:8980"
instance_name = "pigeonhole"
max_batch_total_size = "4 MiB"
# "off" disables TTL GC for CAS entries.
gc_ttl = "7d"

[sweep]
# Orphans are swept up to the upload horizon: uploads are pinned before they
# start and unpinned once committed, so no grace period is needed.
# Pause between full sweeper passes.
interval = "1m"
# Candidate keys fetched / deleted per batch.
batch_size = 100

[repair]
# Pause between repair / backfill passes.
interval = "30s"
# Jobs claimed per pass (fewest-replica chunks first).
batch_size = 16
# Skip a job when source Get or target Put cost().wait_secs exceeds this.
max_cost_wait = "2s"
# Scrub under-replicated chunks into the repair queue each pass.
scrub = true

[http]
# Idle timeout for request/response bodies (resets on each byte frame).
# Large streaming PUT/GET may run longer than this while bytes keep flowing.
request_timeout = "5m"
# Time to produce response headers after the request body is fully received.
# Defaults to request_timeout when omitted; "off" disables.
headers_timeout = "5m"
# Cap concurrent in-flight HTTP requests (tower ConcurrencyLimitLayer).
max_concurrent_requests = 256
# Reject requests with more headers than this (431).
max_headers = 100

# What the process logs, to stderr (docs/observability.md). RUST_LOG, when
# set, replaces `level` (openraft and s3s stay quiet unless it names them).
[log]
level = "info,openraft=warn,s3s=off"   # tracing directives
format = "text"                         # or "json" (one object per line, with spans)
slow_request = "5s"                     # slower S3 requests are logged at info

# Prometheus scrape (requires binary feature `metrics-prometheus`, on by default).
[metrics]
enabled = false
# Empty = serve GET /metrics on listen_addr. Set e.g. "127.0.0.1:9090" for a
# dedicated scrape port.
# listen_addr = ""
