# Copy to s3gram.toml and adjust. Secrets stay in .env (see .env.example).
#
#   cp s3gram.toml.example s3gram.toml
#   cp .env.example .env
#
# Override path with S3GRAM_CONFIG=/path/to.toml

# Telegram chat/channel for blobs + index snapshots (bot must be admin with pin rights).
# Channels: enable "Edit messages". Groups: enable "Pin messages".
# Pinning in groups also posts a service message.
chat_id = "-1001234567890"

listen_addr = "0.0.0.0:8333"
database_url = "sqlite:s3gram.db"
region = "us-east-1"

# true = MemoryBlobStore (no Telegram). For local suites / CI.
memory = false

[snapshot]
# Seconds between automatic index snapshots. 0 disables.
interval_secs = 300

[chunk]
# Max on-wire chunk size in bytes (Telegram getFile < 20 MiB). Default 19 MiB.
# Max on-wire document size. With codec zstd/gzip, independent 1 MiB frames are
# packed until this size (or 256 MiB logical) is reached.
size = 19922944
# Encoding policy for new uploads: "raw" | "gzip" | "zstd" (default zstd).
# Compressing policies store chunks as codec "frames" (see chunk_frames table).
codec = "zstd"
# Logical frame size for frame packing (default 1 MiB).
frame_size = 1048576

[ingest]
# Process-wide cap on ingest buffers across concurrent PUTs (default 256 MiB).
memory_budget = 268435456

[telegram]
# Separate Bot API budgets (sends must not starve reads / deletes).
send_rate_per_sec = 0.5
send_burst = 3.0
get_file_rate_per_sec = 15.0
get_file_burst = 30.0
delete_rate_per_sec = 1.0
delete_burst = 5.0
upload_concurrency = 2
download_concurrency = 8
# Legacy aliases (map to send_*): rate_per_sec, rate_burst
