# Copy to s3gram.toml and adjust. Secrets stay in .env (see .env.example).
#
#   cp s3gram.toml.example s3gram.toml
#   cp .env.example .env
#
# Override path with S3GRAM_CONFIG=/path/to.toml

# Telegram chat/channel for blobs + index snapshots (bot must be admin with pin rights).
# Channels: enable "Edit messages". Groups: enable "Pin messages".
# Pinning in groups also posts a service message.
# Legacy single-backend form (synthesizes instance id="default"). Prefer [[instances]].
chat_id = "-1001234567890"

# Multi-backend instances (optional). Secrets via env names, never inline tokens.
# [[instances]]
# id = "tg-main"
# kind = "telegram"
# bot_token_env = "BOT_TOKEN"
# chat_id = -1001234567890
# role = "read-write"   # read-write | read-only | retired
#
# [[instances]]
# id = "dc-backup"
# kind = "discord"
# bot_token_env = "DISCORD_BOT_TOKEN"
# channel_id = 123456789012345678
# role = "read-write"

listen_addr = "0.0.0.0:8333"
database_url = "sqlite:s3gram.db"
region = "us-east-1"

# true = MemoryBlobStore (no Telegram). For local suites / CI.
memory = false

[snapshot]
# Seconds between automatic index snapshots. 0 disables.
interval_secs = 300

[chunk]
# Max on-wire chunk size in bytes (Telegram getFile < 20 MiB). Default 19 MiB.
# Max on-wire document size. With codec zstd/gzip, independent 1 MiB frames are
# packed until this size (or 256 MiB logical) is reached.
size = 19922944
# Encoding policy for new uploads: "raw" | "gzip" | "zstd" (default zstd).
# Compressing policies store chunks as codec "frames" (see chunk_frames table).
codec = "zstd"
# Logical frame size for frame packing (default 1 MiB).
frame_size = 1048576

[ingest]
# Process-wide cap on ingest buffers across concurrent PUTs (default 256 MiB).
memory_budget = 268435456

[telegram]
# Separate Bot API budgets (sends must not starve reads / deletes).
send_rate_per_sec = 0.5
send_burst = 3.0
get_file_rate_per_sec = 15.0
get_file_burst = 30.0
delete_rate_per_sec = 1.0
delete_burst = 5.0
upload_concurrency = 2
download_concurrency = 8
# Legacy aliases (map to send_*): rate_per_sec, rate_burst

[cache]
# L0 (Telegram file_path) + L1 frames + L2 compressed blobs.
enabled = true
# L2 in-memory capacity (bytes).
memory_bytes = 268435456
# Empty disk_path = memory-only L2 (no foyer disk tier).
disk_path = ""
# Required when disk_path is set (do not rely on foyer free-space defaults).
# disk_bytes = 1073741824
# L1 unpacked-frame memory budget.
frame_memory_bytes = 134217728
readahead_frames = 2
write_through = true
# Blobs larger than this are not admitted to L2 disk.
max_object_bytes = 20971520

# Bazel/Buck2 remote cache (REAPI v2 + ByteStream). Requires building s3gram with
# `--features bytestream`. Disabled by default.
[bytestream]
enabled = false
listen_addr = "127.0.0.1:8980"
instance_name = "s3gram"
max_batch_total_size_bytes = 4194304
# 0 disables TTL GC for CAS entries.
gc_ttl_secs = 604800

# Discord backend (default binary feature `discord`). Secret: DISCORD_BOT_TOKEN.
# [backend]
# kind = "discord"
# [discord]
# channel_id = "123456789012345678"
# # max_blob_size = 10485760

[http]
# Idle timeout for request/response bodies (resets on each byte frame).
# Large streaming PUT/GET may run longer than this while bytes keep flowing.
request_timeout_secs = 300
# Time to produce response headers after the request body is fully received.
# Defaults to request_timeout_secs when omitted; set 0 to disable.
headers_timeout_secs = 300
# Cap concurrent in-flight HTTP requests (tower ConcurrencyLimitLayer).
max_concurrent_requests = 256
# Reject requests with more headers than this (431).
max_headers = 100
