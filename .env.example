# Secrets / credentials only. Non-secret settings live in pigeonhole.toml.
#
# Env vars referenced by [[store]] (defaults shown). Telegram: a bot token from
# @BotFather and an app's api id / hash from my.telegram.org.
BOT_TOKEN=123456:ABCDEF
TG_API_ID=12345
TG_API_HASH=0123456789abcdef0123456789abcdef
# DISCORD_BOT_TOKEN=your.discord.bot.token
#
# Only for scripts/compat-telegram.sh / compat-discord.sh (throwaway channels;
# compat-telegram reads the token from TG_BOT_TOKEN):
# TG_BOT_TOKEN=123456:ABCDEF
# TG_BLOBS_CHAT_ID=-1001234567890
# DISCORD_CHANNEL_ID=123456789012345678
#
AWS_ACCESS_KEY_ID=pigeonhole
AWS_SECRET_ACCESS_KEY=pigeonholesecret
