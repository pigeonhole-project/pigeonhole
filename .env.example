# Secrets / credentials only. Non-secret settings live in s3gram.toml.
#
# Telegram backend ([backend] kind = "telegram" or omitted):
BOT_TOKEN=123456:ABCDEF
#
# Discord backend ([backend] kind = "discord"):
# DISCORD_BOT_TOKEN=your.discord.bot.token
#
AWS_ACCESS_KEY_ID=s3gram
AWS_SECRET_ACCESS_KEY=s3gramsecret
