BOT_TOKEN=123456:ABCDEF
# Service Telegram chat ONLY: registry JSON + index snapshots.
# Never used for S3 object data.
SERVICE_CHAT_ID=-1001234567890
# Admin chat for /bucket commands (required)
ADMIN_CHAT_ID=123456789
# Optional: auto-bind CreateBucket to this chat (tests). Must differ from SERVICE_CHAT_ID.
# DEFAULT_DATA_CHAT_ID=-1009876543210
SERVICE_BUCKET=s3gram
AWS_ACCESS_KEY_ID=s3gram
AWS_SECRET_ACCESS_KEY=s3gramsecret
AWS_REGION=us-east-1
LISTEN_ADDR=0.0.0.0:8333
DATABASE_URL=sqlite:s3gram.db
SNAPSHOT_INTERVAL_SECS=300
# S3GRAM_INSECURE=1
